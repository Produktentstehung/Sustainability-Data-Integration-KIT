# Configuration of the Sustainability Data Integration KIT
#
# Copy this file to .env and fill it in. The filled-in file is excluded from
# version control and does not belong in the repository.

# --- AAS server -------------------------------------------------------------
# The addresses below are literal 127.0.0.1, not "localhost". "localhost"
# resolves to ::1 and to 127.0.0.1, and Node.js then tries both families for
# every single request. That doubles the source ports a run consumes, and on
# Windows the supply is limited and slow to come back - see "Out of local
# ports" in TUTORIAL.md. Both spellings reach the same service.
SDI_AAS_URL=http://127.0.0.1:8081
# Namespace of the shells; the part AAS identifiers are derived from it
SDI_AAS_BASE=localhost/demo/aas
SDI_AAS_DATASOURCES_ID=localhost/demo/aas/Kugelschreiber_TracePEN/DataSources

# --- openLCA ----------------------------------------------------------------
SDI_OPENLCA_URL=http://127.0.0.1:8080
# The product system of the data package under getting-started/openlca.
# It is the only one the package contains, so this value fits as soon as
# the package has been imported. Another model needs another identifier;
# "python setup.py --step 4" lists what the open database holds.
SDI_OPENLCA_PRODUCT_SYSTEM=9eb5b6f3-bf7a-4bf5-a4c5-c2ebe875dac5
# Impact method used when nothing is selected in the dashboard (EF 3.0)
SDI_OPENLCA_DEFAULT_METHOD=b4571628-4b7b-3e4f-81b1-9a8cca6cb3f8
# Reference amount of the calculation
SDI_LCA_AMOUNT=1

# --- Simulation (ema Plant Designer) ----------------------------------------
# Paths may be relative to this folder; start-nodered.ps1 resolves them.
SDI_PYTHON=python
SDI_EMA_SCRIPT=../src/ema_export_to_json.py
SDI_EMA_EXPORT=../docs/sample_data/ema_plantsimulation_data.xlsx
# Scenario column in the export; empty = first column
SDI_EMA_SCENARIO=

# --- Machine data -----------------------------------------------------------
SDI_OPCUA_SUBMODEL_ID=localhost/demo/SubmodelTemplate/SAL-OPC-UA-Daten
# Part currently produced on the lathe: Bolzen or Huelse.
# The lathe makes the first step of the bolt and the sleeve;
# which one is running cannot be derived from the machine data.
SDI_OPCUA_TURNED_PART=Bolzen

# --- ERP (Odoo) -------------------------------------------------------------
# Without these entries the chain still runs on PLM and simulation data.
SDI_ODOO_URL=
SDI_ODOO_DB=
SDI_ODOO_USER=
# Better not to store the API key here. start-nodered.ps1 asks for it when
# SDI_ODOO_DB is set and the key is empty.
SDI_ODOO_APIKEY=
SDI_ODOO_PRODUCT=Kugelschreiber_TracePEN
SDI_ODOO_FLOW_FIELD=x_studio_lca_flow_uuid
SDI_ODOO_MATERIAL_FIELD=x_lca_material
SDI_ODOO_PROCESS_FIELD=x_lca_process_id
SDI_ODOO_PARAMETER_FIELD=x_lca_parameter
SDI_ODOO_ZERO_FIELD=x_lca_zero_parameters

# --- PLM (CONTACT Elements) -------------------------------------------------
# Only needed for PLM.json. The flow is a reference implementation; the values
# below describe your own installation.
# Bare server address, without a trailing /web or /odoo style path
SDI_PLM_URL=
SDI_PLM_USER=
# Better not to store the password here. start-nodered.ps1 asks for it when
# SDI_PLM_USER is set and the password is empty.
SDI_PLM_PASSWORD=
# Working directory for intermediate files of the product flow. Relative to the
# directory Node-RED was started in; leave it empty to use jobs/product.
SDI_PLM_WORK_DIR=
# Template of the administration shell, output directory and the script that
# builds the shell from the PLM data
SDI_PLM_BASE_SHELL=
SDI_PLM_OUTPUT=
SDI_PLM_SCRIPT=

# --- Node-RED ---------------------------------------------------------------
# Key used to encrypt stored credentials
SDI_CREDENTIAL_SECRET=

# --- Serial numbers ---------------------------------------------------------
# Which articles are produced in house and therefore carry a serial number.
# Purchased parts are left out on purpose: a serial number on them would claim
# a production that never happened here.
#
# The coding is ASSEMBLY-INSTANCE-PART-INSTANCE, see ODOO.md:
#     000114-001-000116-038   the 38th bolt, in pen number one
SDI_ASSEMBLY_ARTICLE=000114
SDI_SERIAL_ARTICLES=000114,000116,000117,000120
SDI_SERIAL_DIGITS=3

# --- Dashboard and chain -----------------------------------------------------
# Which shell the dashboard shows by default, and which part it looks at for
# machine data as long as the product itself is selected.
SDI_LCA_PRODUCT=Kugelschreiber_TracePEN
SDI_LCA_MACHINE_PART=Bolzen_Aluminium

# The dashboard starts the other flows through the Node-RED admin interface,
# and it links every part name to that part in the AAS web interface.
# SDI_AAS_UI_URL is opened by the browser, not called by a flow, so it keeps
# the friendlier spelling. Its port is the one docker-compose publishes the
# web interface on, AAS_UI_PORT, which defaults to 3000.
SDI_NODERED_URL=http://127.0.0.1:1880
SDI_AAS_UI_URL=http://localhost:3000

# Where the export button writes its packages, and which program it calls.
# The folder is relative to the directory Node-RED was started in.
SDI_EXPORT_DIR=export
SDI_EXPORT_SCRIPT=../src/export_aasx.py

# --- Command line ------------------------------------------------------------
# record_opcua.py needs the machine server.
#
# SDI_LCA_SHELL is the shell the chain calculates when it is started without
# the dashboard. It is the full identifier, not the name: the submodel to read
# is formed from it, and a bare name produced
# "Kugelschreiber_TracePEN/DataSources", which exists nowhere. A name is
# accepted as well and SDI_AAS_BASE is put in front of it.
SDI_LCA_SHELL=localhost/demo/aas/Kugelschreiber_TracePEN
SDI_LCA_PROCESS_NAME=Kugelschreiber TRACEpen
SDI_OPCUA_URL=opc.tcp://127.0.0.1:4840

# Scratch directory of the PLM flow: one folder per job, holding the CAD file
# and the data handed to the Python script. Relative to the directory Node-RED
# was started in.
SDI_PLM_JOBDIR=jobs

# --- Dataspace: EDC connector and object storage -----------------------------
# The bridge publishes a shell into a Tractus-X dataspace: it writes the shell
# into an S3-compatible bucket and registers it on an EDC connector as an asset
# with a contract. A partner connector then negotiates a contract and fetches
# it. Details in EDC.md.
#
# Leave SDI_EDC_MANAGEMENT_URL empty to leave the whole thing out. The setup
# then does not load the three dataspace tabs at all, and the rest of the KIT
# is unaffected.
#
# Neither the connectors nor the bucket can be created locally. Ask whoever
# runs your dataspace infrastructure for the addresses and keys.

# Your own connector
SDI_EDC_MANAGEMENT_URL=
# The two policies the bootstrap script creates, by their fixed names
SDI_EDC_ACCESS_POLICY_ID=aas-bridge-access-policy
SDI_EDC_CONTRACT_POLICY_ID=aas-bridge-contract-policy

# The partner you exchange with
SDI_EDC_PARTNER_MANAGEMENT_URL=
SDI_EDC_PARTNER_DSP_URL=
SDI_EDC_PARTNER_BPN=

# The bucket the shell is written to. S3-compatible; the reference setup uses
# Cloudflare R2, where the region is always "auto".
SDI_S3_BUCKET=
SDI_S3_REGION=auto
SDI_S3_ENDPOINT=
SDI_S3_PUBLIC_URL=
SDI_S3_ACCESS_KEY_ID=

# Better not to store these here. start-nodered.ps1 asks for them once
# SDI_EDC_MANAGEMENT_URL is filled in and the value is empty:
#   SDI_EDC_API_KEY           key of your own connector
#   SDI_EDC_PARTNER_API_KEY   key of the partner connector
#   SDI_S3_SECRET_ACCESS_KEY  secret key of the bucket
#   SDI_EDC_BACKEND_KEY       shared key of the dashboard's own endpoints
