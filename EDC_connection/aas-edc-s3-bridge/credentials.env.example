# Copy this file to credentials.env and fill in real values.
# credentials.env is gitignored - never commit real secrets.
# See SETUP.md for where each value comes from.

# --- Cloudflare R2 (bucket: aas-bucket) ---
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<HASH>.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- EDC connector HNI-01 ---
EDC_MANAGEMENT_URL_HNI01=
EDC_API_KEY_HNI01=

# --- EDC connector HNI-02 ---
EDC_MANAGEMENT_URL_HNI02=
EDC_API_KEY_HNI02=

# --- Shared policies (identical name on both connectors, created once via
#     edc-bootstrap-policies.ps1) ---
EDC_ACCESS_POLICY_ID=aas-bridge-access-policy
EDC_CONTRACT_POLICY_ID=aas-bridge-contract-policy

# --- Bridge endpoint protection (self-chosen, not issued by any external service) ---
BACKEND_API_KEY=
